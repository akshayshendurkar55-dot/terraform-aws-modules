# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude local tfvars files containing environment-specific or sensitive values
*.tfvars
*.tfvars.json

# Allow example / template tfvars files to be committed to Git
!*.tfvars.example
!*.tfvars.sample

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI and sensitive credential files
*.pem
*.key
*.id_rsa
*.id_rsa.pub
credentials
*.credentials
.env
.env.*

# OS metadata
.DS_Store
Thumbs.db

